# Downloaded papers: most cannot be redistributed. Links are in references/README.md.
references/*.pdf
references/*.html

/target
/scratch

# Training and evaluation data: never committed. data/fetch.sh re-downloads it.
data/*
!data/fetch.sh
!data/README.md

# Run state lives in runs/ (programs per round, checkpoints, ledgers, logs).
# Only the active-run record is committed; milestone metrics and the
# program are copied to results/ and program/.
/runs/*
!/runs/current-run.json
/worktrees/
