/// An argument of a word whose meaning is not known yet.
r0 role arg : Thing -> Thing  @0 seed
/// Something an unknown modifier word adds.
r1 role mod : Thing -> Thing  @0 seed
/// One of the things joined by a coordination.
r2 role op : Thing -> Thing  @0 seed
/// Who does it on purpose.
r3 role agent : Event -> Thing  @1
/// What is affected, changed, made, moved.
r4 role patient : Event -> Thing  @1
/// What a state or property is about.
r5 role theme : Thing -> Thing  @1
/// Who feels, perceives, knows, wants.
r6 role experiencer : Event -> Thing  @1
/// What is felt, perceived, liked.
r7 role stimulus : Event -> Thing  @1
/// Who receives.
r8 role recipient : Event -> Thing  @1
/// Where to.
r9 role goal : Thing -> Thing  @1
/// Where.
r10 role location : Thing -> Thing  @1
/// When.
r11 role time : Thing -> Thing  @1
/// How.
r12 role manner : Thing -> Thing  @1
/// A property of a thing.
r13 role attr : Thing -> Thing  @1
/// Whose.
r14 role possessor : Thing -> Thing  @1
/// How many or how much.
r15 role quantity : Thing -> Thing  @1
/// What is said, thought, known, wanted.
r16 role content : Event -> Thing  @1
/// What something is about.
r17 role topic : Thing -> Thing  @1
/// Why; what brings it about.
r18 role cause : Thing -> Thing  @1
/// What for.
r19 role purpose : Event -> Thing  @1
/// Together with whom.
r20 role companion : Event -> Thing  @1
/// How much of a property.
r21 role degree : Thing -> Thing  @1
/// A discourse marker or interjection accompanying the utterance.
r22 role discourse : Thing -> Thing  @1
/// Under what condition (if-clause).
r23 role condition : Thing -> Thing  @1
/// An event the thing takes part in (relative clause).
r24 role relative : Thing -> Event  @1
/// Where from.
r25 role source : Thing -> Thing  @1
/// With what.
r26 role instrument : Event -> Thing  @1
/// The person addressed by name or description within the sentence.
r27 role vocative : Thing -> Thing  @1
/// What something is compared with ('as a goat', 'as white').
r28 role compare : Thing -> Thing  @1
/// Despite what ('in spite of').
r29 role concession : Thing -> Thing  @1
/// For whom.
r30 role beneficiary : Thing -> Thing  @1
/// The state brought about by causing.
r31 role result : Event -> Thing  @1
/// What a comparison is made against (than).
r32 role standard : Property -> Thing  @1

/// Referent identifiable by hearer or new.
f0 feature def : Thing = yes | no  @1
/// How many.
f1 feature num : Thing = one | many  @1
/// When, relative to speaking.
f2 feature time : Thing = past | now | future  @1
/// Finished, in progress, habitual.
f3 feature aspect : Thing = done | ongoing | habit  @1
/// Negation.
f4 feature polarity : Thing = neg  @1
/// Question, command, wish, ability, obligation.
f5 feature mood : Thing = ask | order | wish | can | must  @1
/// Counterfactual: would have happened but did not.
f6 feature reality : Event = counter  @1
